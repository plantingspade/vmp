<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VMP.Gui.Views.VehicleTypeView">
    
             <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock
            HorizontalAlignment="Center"
            Margin="5"
            FontSize="20"
            Foreground="Black">
            Select your vehicle type
        </TextBlock>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Width="100" Height="100"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Margin="10"
                    Padding="10"
                    CornerRadius="20"
                    Background="#8CFFFFFF"
                    BorderBrush="#CCFFFFFF"
                    BorderThickness="1"
                    Click="Motorcycle_Click">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Width="45" Height="45"
                           Source="/Assets/motorcycle.png">
                    </Image>
                    <TextBlock
                        Margin="0,10,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        FontSize="12"
                        Foreground="Black">
                        Motorcycle
                    </TextBlock>
                </StackPanel>
            </Button>
            <Button Width="100" Height="100"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Margin="10"
                    Padding="10"
                    CornerRadius="20"
                    Background="#8CFFFFFF"
                    BorderBrush="#CCFFFFFF"
                    BorderThickness="1"
                    Click="Car_Click">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Width="45" Height="45"
                           Source="/Assets/car.png">
                    </Image>
                    <TextBlock
                        Margin="0,10,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        FontSize="12"
                        Foreground="Black">
                        Car
                    </TextBlock>
                </StackPanel>
            </Button>
            <Button Width="100" Height="100"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Margin="10"
                    Padding="10"
                    CornerRadius="20"
                    Background="#8CFFFFFF"
                    BorderBrush="#CCFFFFFF"
                    BorderThickness="1"
                    Click="Truck_Click">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Width="45" Height="45"
                           Source="/Assets/truck.png">
                    </Image>
                    <TextBlock
                        Margin="0,10,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        FontSize="12"
                        Foreground="Black">
                        Truck
                    </TextBlock>
                </StackPanel>
            </Button>
            <Button Width="100" Height="100"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Margin="10"
                    Padding="10"
                    CornerRadius="20"
                    Background="#8CFFFFFF"
                    BorderBrush="#CCFFFFFF"
                    BorderThickness="1"
                    Click="Other_Click">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Width="45" Height="45"
                           Source="/Assets/bus.png">
                    </Image>
                    <TextBlock
                        Margin="0,10,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        FontSize="12"
                        Foreground="Black">
                        Other
                    </TextBlock>
                </StackPanel>
            </Button>
        </StackPanel>
    </StackPanel>

</UserControl>